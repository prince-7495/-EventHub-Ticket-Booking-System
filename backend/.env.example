# Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server Port
PORT=5000

# MongoDB Connection URI
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/eventhub

# MongoDB Atlas (production):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/eventhub

# JWT Secret (use a long random string for production)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters_long
